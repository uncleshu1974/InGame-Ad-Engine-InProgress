# Configurazione Email (SMTP)
# Sostituisci questi valori con le tue credenziali reali (es. Gmail, SendGrid, ecc.)
# Per Gmail, la porta solitamente è 587 e serve una "App Password".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=la_tua_email@gmail.com
SMTP_PASSWORD=la_tua_app_password

# Configurazione Database (Auth Service)
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=your_secure_password
AUTH_DB_ROOT_PASSWORD=your_secure_root_password

# Configurazione Database (Campaign Service)
CAMPAIGN_DB_USER=campaign_user
CAMPAIGN_DB_PASSWORD=your_secure_password
CAMPAIGN_DB_ROOT_PASSWORD=your_secure_root_password
